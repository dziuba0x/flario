# Flario environment configuration
# Copy this file to ".env" and adjust. Every variable is OPTIONAL: the server runs
# against the public Flare RPCs and Flare-hosted FDC services with no config at all.
# Anything secret belongs here and nowhere else. .env is gitignored.

# --- RPC endpoints -----------------------------------------------------------

# Flare Mainnet RPC (chainId 14). Defaults to the public endpoint below.
FLARE_RPC=https://flare-api.flare.network/ext/C/rpc

# Coston2 Testnet RPC (chainId 114). Defaults to the public endpoint below.
FLARE_RPC_TESTNET=https://coston2-api.flare.network/ext/C/rpc

# Songbird Canary-Network RPC (chainId 19). Defaults to the public endpoint.
# FLARE_RPC_SONGBIRD=https://songbird-api.flare.network/ext/C/rpc

# Coston Testnet RPC (chainId 16). Defaults to the public endpoint.
# FLARE_RPC_COSTON=https://coston-api.flare.network/ext/C/rpc

# --- FDC attestations --------------------------------------------------------

# SENSITIVE. Local signing key used by fdc_request_attestation and
# fdc_web2json_request to submit attestation requests (small fee plus gas), and by
# the x402 layer to broadcast client-signed settlements. It signs in-process and is
# never logged or transmitted anywhere except as an already-signed transaction.
# Leave it unset to keep the server read-only: the tools then return a prepared
# request for your own signer.
# FLARE_PRIVATE_KEY=

# API keys for the Flare-hosted verifier and Data Availability services.
# Both default to the public key 00000000-0000-0000-0000-000000000000.
# FDC_VERIFIER_API_KEY=
# FLARE_DA_API_KEY=

# Override the Data Availability layer base URL (for example a self-hosted one).
# FLARE_DA_URL=

# --- x402 paywall (premium tools) --------------------------------------------
# All optional. While disabled (the default) the premium tools run free.

# Turn the paywall on for premium tools.
# X402_ENABLED=true

# Settlement network. Using mainnet ALSO requires X402_ALLOW_MAINNET=true below.
# X402_NETWORK=coston2

# SENSITIVE. Real money. Second gate that must be set before anything settles on
# Flare mainnet, so a misconfigured X402_NETWORK cannot move real funds by itself.
# X402_ALLOW_MAINNET=true

# Address that receives payments. Required once the paywall is enabled, and worth
# double-checking: a typo here sends income to an address nobody controls.
# X402_PAY_TO=

# EIP-3009 payment token override. Defaults: Coston2 test USDT0
# 0xce13911D4896200b543a61E4ae8E829E661Dd8EB, mainnet USD0
# 0xe7cd86e13AC4309349F30B3435a9d337750fC82D.
# The token MUST implement EIP-3009, otherwise settlement cannot work.
# X402_TOKEN_ADDRESS=

# Decimals of the payment token, used to turn prices into base units. Default 6,
# which matches USDT0/USD0. Getting this wrong misprices every call by orders of
# magnitude, so change it only alongside X402_TOKEN_ADDRESS.
# X402_TOKEN_DECIMALS=6

# EIP-712 domain version of the payment token, default "1". It must match the
# token contract, or every signature verification will fail.
# X402_TOKEN_EIP712_VERSION=1

# Prices in whole-token units. Per tool: X402_PRICE_<TOOL_NAME_UPPERCASED>.
# X402_PRICE_DEFAULT=0.001
# X402_PRICE_FASSETS_LIQUIDATION_SCANNER=0.005

# --- Hub mode (HTTP) ----------------------------------------------------------

# Port for hub mode. Same effect as passing --http <port>.
# FLARIO_HTTP_PORT=8402

# Interface to bind. Defaults to 127.0.0.1, which is local only. Setting 0.0.0.0
# exposes every tool to anyone who can reach the port, so only do it behind a
# proxy or firewall you control.
# FLARIO_HTTP_HOST=0.0.0.0

# SENSITIVE. In hub mode anyone who reaches the port is a caller, and attestation
# requests cost a fee plus gas. Submission is therefore DISABLED by default in hub
# mode even when FLARE_PRIVATE_KEY is set (that key is there to settle x402
# payments). Enable this only if you intend to pay for callers' requests.
# FLARIO_HUB_ALLOW_SUBMIT=true

# --- Optional data sources ---------------------------------------------------

# Indexer endpoint for get_ftso_providers. Must return a JSON array of providers,
# or an object shaped like { "providers": [ ... ] }. The tool appends
# ?network=mainnet|coston2 automatically.
# FLARE_PROVIDERS_API=

# Fallback metrics API for get_fassets_status, consulted only if the on-chain read
# fails. The tool requests <base>/fassets/status.
# FLARE_METRICS_API=
